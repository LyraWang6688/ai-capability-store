# macOS Finder metadata. A pattern without a slash matches at every level, so
# this one line covers every directory. Without it, `git add -A` silently
# commits .DS_Store into the Store.
.DS_Store

# The validator's Python dependencies. store-publish's "环境准备" step creates
# this venv inside the checkout so it survives across sessions (unlike /tmp),
# and it must never be committed.
.venv/

# Python bytecode (automation tests import modules by path)
__pycache__/
*.pyc

# 依赖目录。新增能力包时容易忘记，`git add -A` 会把整个 node_modules
# 提交进来（实测一次 671 个文件），CI 的「Nothing generated is tracked」会拦。
node_modules/

# TypeScript 构建产物（各能力包自己的 .gitignore 未必覆盖）
dist/

# 交接文档与内部问题记录 —— 不进公开仓库
#
# 理由：它们包含服务器地址、飞书 base/table token、内部部署路径、会话 id。
# 这些不是"秘密"（都不是凭据），但它们是【内部坐标】——
# 公开仓库里列出"哪台机器跑什么"，等于替人画了一张地图。
#
# 它们仍然需要存在（交接的人要读），所以：
#   - 文件留在工作区（gitignored，不提交）
#   - 位置在它所描述的工作旁边（orchestrations/scheduled-task/HANDOFF.md）
orchestrations/**/HANDOFF.md
docs/

# 兜底：任何位置的交接产物都不入库（DSH user-global G07）。
# 上面的路径规则只覆盖已知位置；换一个目录写交接时，这几行也会挡住
# `git add -A`。Go 大小写敏感，所以 HANDOFF / handoff 两种都写。
HANDOFF.md
HANDOFF/
handoff-*.md
*handoff*.md

# 本地开发打包产物（插件临时安装用，不入库）
*.tgz

# 本地 skill 软链：源码在 ~/.agents/skills/<name>，软链不提交
# 由 scripts/link_local_skill.py 维护；校验器要求每个软链都有对应的一行。
# 软链不是资产：没有内容可克隆，提交后在任何别的机器上都是断链。
skills/store-publish

# 本地 skill 软链：源码在 ~/.agents/skills/<name>，软链不提交
# 由 scripts/link_local_skill.py 维护；校验器要求每个软链都有对应的一行。
