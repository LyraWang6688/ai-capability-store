[Unit]
Description=Deliver the latest ops-audit report into the Feishu task inbox
After=network-online.target ops-audit.service

[Service]
Type=oneshot
User=dshjobs
Environment=HOME=/srv/dsh-jobs
Environment=PATH=/srv/dsh-jobs/node/bin:/srv/dsh-jobs/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/srv/dsh-jobs/env/app.env
ExecStart=/srv/dsh-jobs/scripts/ops-audit-inbox.py
Nice=10
