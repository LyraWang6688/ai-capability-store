{
  "name": "wechat-draft-mcp",
  "version": "0.3.2",
  "type": "module",
  "description": "本地 MCP 服务：把磁盘上的文章创建或原地更新为微信公众号草稿；更新/删除属破坏性操作，默认关闭。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/mcp/wechat-draft-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wechat",
    "wechat-official-account",
    "draft"
  ],
  "bin": {
    "wechat-draft-mcp": "./dist/mcpServer.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./publish": "./dist/publish.js",
    "./articleBundle": "./dist/articleBundle.js",
    "./wechatApi": "./dist/wechatApi.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/tests/**/*.test.js\"",
    "test:only": "node --test \"dist-test/tests/**/*.test.js\"",
    "check:pack": "npm run typecheck && npm test && npm pack --dry-run",
    "mcp": "node dist/mcpServer.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
