{
  "name": "investdesk-quotes",
  "version": "0.2.0",
  "description": "A 股与场外公募基金行情查询 + 飞书多维表格持仓读写的 MCP 服务。可装进豆包工作 / Claude Desktop 等支持 MCP 的 AI 宿主。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "investdesk-quotes": "dist/mcp/stdio.js",
    "investdesk-quotes-http": "dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stock",
    "etf",
    "fund",
    "portfolio",
    "feishu",
    "investment"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/mcp/investdesk-quotes"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "node dist/mcp/server.js",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "quote": "node dist/cli/quote.js",
    "check:pack": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}