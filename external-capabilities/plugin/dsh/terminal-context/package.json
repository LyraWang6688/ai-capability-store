{
  "name": "@lyra_wang/dsh-terminal-context",
  "version": "0.5.1",
  "type": "module",
  "description": "把 DSH 右侧边栏终端共享给 Agent：用户点「共享终端」后，每一步都在上下文里，并在报错 / 等待输入 / 交互式程序 / 卡住时主动提醒。默认不共享，关掉彻底静默。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/plugin/dsh/terminal-context"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "terminal",
    "context"
  ]
}
