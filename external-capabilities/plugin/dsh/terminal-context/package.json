{
  "name": "@lyra_wang/dsh-terminal-context",
  "version": "0.6.0",
  "type": "module",
  "description": "DSH 输入框左侧的「发送终端」按钮：点一下就把右侧边栏终端当前可见的最后 20 行发给 AI（并唤醒它）。没有常驻监听、没有自动上报——什么时候把终端交给 AI 由人决定。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/plugin/dsh/terminal-context"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "terminal",
    "context"
  ]
}
