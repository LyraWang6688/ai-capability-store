{
  "name": "@lyra_wang/dsh-quick-commands",
  "version": "0.1.3",
  "description": "Quick commands for DeepSeek Harness: one button next to the composer keeps your reusable snippets, inserts them as editable text, or sends one in a click.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "snippets",
    "prompts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/plugin/dsh/quick-commands"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
