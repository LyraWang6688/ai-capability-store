{
  "name": "@lyra_wang/dsh-diagram-card",
  "version": "0.1.1",
  "description": "Render ```dsh-diagram code blocks in the DSH conversation as structured card diagrams. Compact layout and correct light/dark theme detection.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "client-plugin",
    "diagram",
    "architecture",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraWang6688/ai-capability-store.git",
    "directory": "external-capabilities/plugin/dsh/diagram-card"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
